	partition reconciliation = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "\output\reconciliation.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"line", type text}, {"amount", type number}, {"running", type number}, {"sort_order", Int64.Type}, {"delta", type number}, {"balanced", type logical}, {"unexplained", type number}})
				in
				    Typed
