table reconciliation
	lineageTag: 181fe3bf-8f01-5f1c-906e-5af516101134

	column line
		dataType: string
		lineageTag: 5578d799-ca83-5858-b3f5-9ae15764f7a5
		summarizeBy: none
		sourceColumn: line
		sortByColumn: sort_order

	column amount
		dataType: double
		formatString: \$#,0.00
		lineageTag: 3882f9a7-04ed-5649-ab8e-bddc80baa5d8
		summarizeBy: sum
		sourceColumn: amount

	column running
		dataType: double
		formatString: #,0.00
		lineageTag: 8a0df7ea-686d-5ef4-9190-b247d2d68070
		summarizeBy: sum
		sourceColumn: running

	column sort_order
		dataType: int64
		formatString: 0
		lineageTag: 43957cb4-43fe-5494-9b0c-16ddf0c6359a
		summarizeBy: none
		sourceColumn: sort_order

	column delta
		dataType: double
		formatString: #,0.00
		lineageTag: 24809b85-b96d-59ce-bdd9-b9b8fc5e6100
		summarizeBy: sum
		sourceColumn: delta

	column balanced
		dataType: boolean
