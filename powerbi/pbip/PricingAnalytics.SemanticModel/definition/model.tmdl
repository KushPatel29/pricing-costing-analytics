model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_product", "dim_customer", "dim_competitor", "dim_month", "fact_sales", "price_waterfall", "leakage_by_dimension", "elasticity_estimates", "price_change_hurdles", "price_response_curve", "competitive_index", "passthrough", "cost_variance_long", "budget_variance", "overhead_variance", "margin_bridge_effects", "price_bands", "segment_profile", "wtp_curve", "wtp_fits", "customer_profitability", "deal_scores", "guardrail_summary", "bundle_candidates", "unit_economics", "break_even_products", "break_even_portfolio", "break_even_curve", "markup_vs_margin", "scenario_three_point", "scenario_tornado", "scenario_thresholds", "forecast_series", "forecast_accuracy", "forecast_summary", "profitability", "profit_heatmap", "discount_margin_matrix", "promotion_summary", "price_vs_volume", "cost_element_summary", "cost_element_waterfall", "cost_element_by_category", "price_change_log", "price_list_coverage", "data_quality_checks", "data_quality_score", "reconciliation", "recommendations", "recommendation_summary", "guardrail_exceptions", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_product
ref table dim_customer
