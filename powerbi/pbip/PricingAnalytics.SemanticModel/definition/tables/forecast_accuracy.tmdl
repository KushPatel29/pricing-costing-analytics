	partition forecast_accuracy = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "\output\forecast_accuracy.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"measure", type text}, {"method", type text}, {"wape", type number}, {"mape", type number}, {"bias", type number}, {"folds", Int64.Type}, {"rank", Int64.Type}, {"is_best", type logical}})
				in
				    Typed
