table _Measures
	lineageTag: b3af0e1a-e074-5138-8219-b2afbf523da6

	measure 'List value' = SUM(fact_sales[list_value])
		formatString: \$#,0
		lineageTag: 66317ac7-1984-52ca-a184-53e5236a8dc1
		displayFolder: 01 Revenue

	measure 'Invoice revenue' = SUM(fact_sales[revenue])
		formatString: \$#,0
		lineageTag: 5be1f2d2-fab9-5f83-af0b-0fad399b394d
		displayFolder: 01 Revenue

	measure 'Pocket revenue' = SUM(fact_sales[pocket_revenue])
		formatString: \$#,0
		lineageTag: b4e3b927-eaa7-5ac7-b115-d2c6b70980bd
		displayFolder: 01 Revenue

	measure 'COGS' = SUM(fact_sales[cogs])
		formatString: \$#,0
		lineageTag: 79c508ef-1800-58d0-a2a1-f9adb4293aee
		displayFolder: 01 Revenue

	measure 'Volume (units)' = SUM(fact_sales[quantity_units])
		formatString: #,0
		lineageTag: b0686662-f974-5d5c-b37e-389ace72e46e
		displayFolder: 01 Revenue

	measure 'Invoice lines' = COUNTROWS(fact_sales)
		formatString: #,0
		lineageTag: 4f46ce28-3d11-5c51-987f-5e901696d8b6
		displayFolder: 01 Revenue

	measure 'Pocket margin $' = [Pocket revenue] - [COGS]
		formatString: \$#,0
		lineageTag: 9ac815dd-f79f-5e90-9f36-54f16f0fa1e0
		displayFolder: 01 Revenue

	measure 'Pocket margin %' = DIVIDE([Pocket margin $], [Pocket revenue])
		formatString: 0.0%
		lineageTag: 64b82a52-1866-51e2-b266-eedbe18b5792
		displayFolder: 01 Revenue

	measure 'Invoice margin %' = DIVIDE([Invoice revenue] - [COGS], [Invoice revenue])
		formatString: 0.0%
		lineageTag: caacbf41-08dc-5967-bfa8-13c2b093654e
		displayFolder: 01 Revenue

	measure 'Leakage $' = [List value] - [Pocket revenue]
		formatString: \$#,0
		lineageTag: 63ed84d6-2b88-5621-a2db-39a83a7918f9
		displayFolder: 02 Waterfall

	measure 'Leakage %' = DIVIDE([Leakage $], [List value])
		formatString: 0.0%
		lineageTag: 31abbf78-afa1-5f50-8871-8460d32cf3da
		displayFolder: 02 Waterfall

	measure 'On-invoice discounts' = SUMX(fact_sales, fact_sales[on_invoice_discounts] * fact_sales[quantity_units])
		formatString: \$#,0
		lineageTag: e65dde4c-bf2b-55a6-8150-717885631e3f
		displayFolder: 02 Waterfall

	measure 'Off-invoice deductions' = SUMX(fact_sales, fact_sales[off_invoice_deductions] * fact_sales[quantity_units])
		formatString: \$#,0
		lineageTag: ea4f59a0-b022-5dbf-a366-a95b3ae7788d
		displayFolder: 02 Waterfall

	measure 'Cost to serve' = SUMX(fact_sales, fact_sales[cost_to_serve] * fact_sales[quantity_units])
		formatString: \$#,0
		lineageTag: 2f1b5bf6-5655-5ab1-84cd-127c91510d49
		displayFolder: 02 Waterfall

	measure 'Waterfall amount' = SUM(price_waterfall[amount])
		formatString: \$#,0
		lineageTag: b6ee1565-c442-5d7c-8af8-9734d06ec046
		displayFolder: 02 Waterfall

	measure 'Waterfall step' = SUM(price_waterfall[delta])
		formatString: \$#,0
		lineageTag: cf4ece98-bdf4-5c7f-b6e6-c52bf9e39398
		displayFolder: 02 Waterfall

	measure 'Deduction amount' = SUM(leakage_by_dimension[amount])
		formatString: \$#,0
		lineageTag: ed2320b0-9835-5acd-9762-b7cf77086147
		displayFolder: 02 Waterfall

	measure 'Deduction % of list' = SUM(leakage_by_dimension[pct_of_list])
		formatString: 0.00%
		lineageTag: 1da6ab68-4d65-5d73-915c-f8c0a4a1948c
		displayFolder: 02 Waterfall

	measure 'List price per unit' = DIVIDE([List value], [Volume (units)])
		formatString: \$#,0.00
		lineageTag: 316b9f16-e307-5eb4-ac87-82daecfd4d44
		displayFolder: 03 Price

	measure 'Pocket price per unit' = DIVIDE([Pocket revenue], [Volume (units)])
		formatString: \$#,0.00
		lineageTag: 6a9d1e76-e2af-5ce1-9f42-a9c879122459
		displayFolder: 03 Price

	measure 'Unit cost' = DIVIDE([COGS], [Volume (units)])
		formatString: \$#,0.00
		lineageTag: d82c2a45-a32f-50ec-aac3-937777793bf6
		displayFolder: 03 Price

	measure 'Pocket revenue LY' =
			VAR vShift = 12
			RETURN CALCULATE(
			    [Pocket revenue],
			    ALL(dim_month),
			    TREATAS(
			        SELECTCOLUMNS(VALUES(dim_month[month_index]),
			                      "month_index", dim_month[month_index] - vShift),
			        dim_month[month_index]
			    )
			)
		formatString: \$#,0
		lineageTag: 745a49b0-e1ad-5c5b-96f7-6031e189bacd
		displayFolder: 04 Comparison

	measure 'Pocket revenue YoY %' = DIVIDE([Pocket revenue] - [Pocket revenue LY], [Pocket revenue LY])
		formatString: 0.0%
		lineageTag: c72e4c0b-6947-5e3f-92eb-8bf75e8fbfc7
		displayFolder: 04 Comparison

	measure 'Pocket margin $ LY' =
			VAR vShift = 12
			RETURN CALCULATE(
			    [Pocket margin $],
			    ALL(dim_month),
			    TREATAS(
			        SELECTCOLUMNS(VALUES(dim_month[month_index]),
			                      "month_index", dim_month[month_index] - vShift),
			        dim_month[month_index]
			    )
			)
		formatString: \$#,0
		lineageTag: 8592b7ad-400c-5c27-b78c-c780e54375f1
		displayFolder: 04 Comparison

	measure 'Pocket margin YoY pts' =
			VAR vNow = [Pocket margin %]
			VAR vThen = DIVIDE([Pocket margin $ LY], [Pocket revenue LY])
			RETURN vNow - vThen
		formatString: 0.0%
		lineageTag: cda14cc8-e975-5569-9725-0b1ca8a9e161
		displayFolder: 04 Comparison

	measure 'Price index' = MEDIANX(competitive_index, competitive_index[price_index])
		formatString: #,0.0
		lineageTag: 17849347-68b5-51af-916b-707a1ccdb7c4
		displayFolder: 05 Competitive

	measure 'Price index target' = 100
		formatString: #,0
		lineageTag: 45aafccf-564d-577c-94a8-f326b29f0e27
		displayFolder: 05 Competitive

	measure 'Products under market' =
			CALCULATE(DISTINCTCOUNT(competitive_index[product_id]),
			          competitive_index[price_index] < 96)
		formatString: #,0
		lineageTag: 0257b8c7-6d86-57dc-bb37-acefe8ac1d53
		displayFolder: 05 Competitive

	measure 'Products over market' =
			CALCULATE(DISTINCTCOUNT(competitive_index[product_id]),
			          competitive_index[price_index] > 115)
		formatString: #,0
		lineageTag: 3d8c687f-e391-5ca3-b7ba-5edff8b848d7
		displayFolder: 05 Competitive

	measure 'Market price' = AVERAGE(competitive_index[market_price])
		formatString: \$#,0.00
		lineageTag: 1ec17d63-6a47-5e50-a3bc-05c6420cfd36
		displayFolder: 05 Competitive

	measure 'Gap to market %' = AVERAGE(competitive_index[gap_pct])
		formatString: 0.0%
		lineageTag: 5261cd4c-7d2d-5b2b-b3e5-3dbb53a217b6
		displayFolder: 05 Competitive

	measure 'Pass-through to list' = AVERAGE(passthrough[passthrough_to_list])
		formatString: 0.00
		lineageTag: b800b85c-9f8a-5c79-a489-0d576e0da64d
