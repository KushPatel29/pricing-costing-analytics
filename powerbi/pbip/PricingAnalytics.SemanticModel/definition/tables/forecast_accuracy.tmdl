table forecast_accuracy
	lineageTag: ea5c083c-51e1-5d1c-bd7a-24c7fdd8ab6c

	column measure
		dataType: string
		lineageTag: 4accd6b2-c4dd-5b9a-bd68-23cf71267988
		summarizeBy: none
		sourceColumn: measure

	column method
		dataType: string
		lineageTag: efbafc85-710c-52e9-a4b8-1e65e11954a1
		summarizeBy: none
		sourceColumn: method

	column wape
		dataType: double
		formatString: #,0.00
