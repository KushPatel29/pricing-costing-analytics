	partition scenario_thresholds = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "\output\scenario_thresholds.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"exists", type logical}, {"input", type text}, {"key", type text}, {"threshold", type number}, {"baseline", type number}, {"reason", type text}})
				in
				    Typed
