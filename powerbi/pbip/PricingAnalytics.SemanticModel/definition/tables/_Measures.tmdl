			VAR vGap = [Pocket margin YoY pts]
			RETURN IF(ISBLANK(vGap), "no prior year",
			          FORMAT(vGap, "+0.0%;-0.0%;0.0%") & " on last year")
		lineageTag: 84208099-eb07-587d-b120-8c5e338497cf
		displayFolder: 12 Labels

	measure 'Leakage reference' = "every point is " & FORMAT([List value] * 0.01, "\$#,0")
		lineageTag: 96a77788-a87d-5a49-8c39-d583204447f3
		displayFolder: 12 Labels

	measure 'Index reference' =
			VAR vIndex = [Price index]
			RETURN FORMAT(vIndex - 100, "+0.0;-0.0;0.0") & " against parity"
		lineageTag: 55c9d59e-afac-5bd1-a0cd-2d41070eb373
		displayFolder: 12 Labels

	measure 'Scenario reference' =
			"price " & FORMAT([Price change value], "+0.0%;-0.0%;0.0%") &
			", cost " & FORMAT([Cost change value], "+0.0%;-0.0%;0.0%") &
			", volume " & FORMAT([Volume change value], "+0.0%;-0.0%;0.0%")
		lineageTag: a395fefd-15fc-5e4c-ad62-6b5d19630a04
		displayFolder: 12 Labels

	measure 'Quality reference' =
			VAR vFailing = [Rows failing]
			RETURN FORMAT(vFailing, "#,0") & " rows of " & FORMAT([Rows checked], "#,0") & " need a fix"
		lineageTag: 956d6dc8-ba19-51dc-899f-c5a59bb311cb
		displayFolder: 12 Labels

