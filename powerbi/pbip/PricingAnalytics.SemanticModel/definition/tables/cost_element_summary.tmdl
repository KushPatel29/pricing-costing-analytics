	column verdict
		dataType: string
		lineageTag: 2ea91f5e-9a0b-5416-a28a-7cd33c2ae642
		summarizeBy: none
		sourceColumn: verdict

	partition cost_element_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "\output\cost_element_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"fiscal_year", Int64.Type}, {"cost_element", type text}, {"behaviour", type text}, {"standard_cost", type number}, {"actual_cost", type number}, {"volume_units", type number}, {"variance", type number}, {"variance_pct", type number}, {"verdict", type text}})
				in
				    Typed
